<Entity name="$projectile_default" tags="projectile_player" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			air_friction="0" 
			mass="0.65"
			>
		</VelocityComponent>
	</Base>

  <ProjectileComponent 
    _enabled="1" 
    speed_min="0"
    speed_max="0"
    on_death_explode="1"
    on_death_gfx_leave_sprite="0" 
    on_lifetime_out_explode="1"
	die_on_low_velocity="0"
    explosion_dont_damage_shooter="1"
    on_collision_die="1"
    ragdoll_force_multiplier="0"
    lifetime="10"
    velocity_sets_scale="1"
    camera_shake_when_shot="0"
	collide_with_shooter_frames="6"
	friendly_fire="1"
    damage="1"	
	muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_magic_large.xml"
	>
    <config_explosion
      never_cache="1" 
      damage="0"
      camera_shake="0" 
      explosion_radius="1" 
      explosion_sprite="data/particles/explosion_016_plasma.xml" 
      explosion_sprite_lifetime="0" 
      create_cell_probability="0" 
      hole_destroy_liquid="0" 
      hole_enabled="1" 
      hole_image="data/temp/explosion_hole.png"
      ray_energy="100000"
      particle_effect="0"
      shake_vegetation="1" 
      sparks_count_min="7"
      sparks_count_max="15"
      sparks_enabled="1"
	  spark_material="spark_blue">
    </config_explosion>
  </ProjectileComponent>
  
  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="data/projectiles_gfx/lance.xml" 
    next_rect_animation=""
    rect_animation="" 
    additive="1"
     >
  </SpriteComponent>
	
	<LightComponent 
    _enabled="1" 
    radius="60"
	r="30"
	g="100"
	b="180"
	>
  </LightComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/nobys_things/mod_data/entities/projectiles/test_proj.xml"
		>
	</VariableStorageComponent>

</Entity>

